# BitGigs environment configuration — copy to .env and fill in.
# .env is gitignored; never commit real secrets.
# Values here are read by bitgigs/settings/base.py at startup;
# real environment variables take precedence over .env.

# --- Django core ---
# Required in production (settings refuse to boot without a real key there).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Which settings module servers use. Dev uses manage.py --settings=bitgigs.settings.local;
# wsgi/asgi default to production if unset.
#DJANGO_SETTINGS_MODULE=bitgigs.settings.production

# Comma-separated hostnames, e.g. bitgigs.example.com,www.bitgigs.example.com
DJANGO_ALLOWED_HOSTS=

# Set to 0 only to exercise the production settings over plain HTTP locally.
#DJANGO_ENABLE_HTTPS=1

# Set to 1 only when BitGigs runs behind a reverse proxy you control. It makes
# the password-reset rate limiter read the client IP from X-Forwarded-For
# (which the proxy sets) instead of REMOTE_ADDR (which would be the proxy).
# Without a proxy, leave it off — the header is client-supplied and spoofable.
#DJANGO_TRUST_PROXY_IP=0

# --- Optional SSO via any OpenID Connect provider ---
# Leave these blank to run BitGigs standalone: native password login, no SSO
# button, no identity provider needed. Set all three to add an SSO button next to
# the password form.
#
# SSO can only sign in the *existing* owner account (matched on email) — it never
# creates a user, because BitGigs is single-tenant and a second account would see
# the owner's data. So finish the onboarding wizard first, then link.
#
# At your provider: create an OAuth2/OpenID application and register the redirect
# URI  http://localhost:8000/accounts/oidc/sso/login/callback/
# OIDC_SERVER_URL is the provider's OpenID configuration issuer, e.g.
#   http://localhost:9000/application/o/bitgigs/   (Authentik)
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- SSO button appearance (all optional) ---
# Unconfigured, the button reads "SSO" in the BitGigs accent colour with a shield
# glyph — correct for any provider, branded for none.
#
# OIDC_PROVIDER_BRAND is a one-word preset for a provider whose icon BitGigs
# bundles. Only "authentik" exists: shipping another vendor's logo means vendoring
# their trademark, so bring your own instead (below).
#OIDC_PROVIDER_BRAND=authentik
#
# Or set any of these directly — each overrides the preset:
#   NAME  button text, "Sign in with <name>"
#   COLOR button fill; text is switched to white or dark for contrast
#   ICON  a static path. Drop the file in assets/static/graphics/ and name it
#         here. Your artwork is used as-is and never recoloured.
#OIDC_PROVIDER_NAME=Keycloak
#OIDC_PROVIDER_COLOR=#4d4d4d
#OIDC_PROVIDER_ICON=graphics/my_idp.svg

# --- Outgoing mail (optional) ---
# There is nothing to set here for normal use: SMTP is configured in the app, at
# Settings -> Email, which is also where the connection test lives. The password
# is stored encrypted with a key derived from DJANGO_SECRET_KEY.
#
# Set this only if you keep secrets out of the database. It overrides the stored
# password, and the settings page then shows that field as environment-managed.
# Note that rotating DJANGO_SECRET_KEY makes a *stored* password unreadable —
# BitGigs says so on the settings page and asks you to re-enter it.
#EMAIL_HOST_PASSWORD=

# --- PostgreSQL (production settings only; dev uses SQLite) ---
POSTGRES_DB=bitgigs
POSTGRES_USER=bitgigs
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
