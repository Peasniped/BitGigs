# BitGigs environment configuration — copy to .env and fill in.
# .env is gitignored; never commit real secrets.
# Values here are read by bitgigs/settings/base.py at startup;
# real environment variables take precedence over .env.

# --- Django core ---
# Required in production (settings refuse to boot without a real key there).
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Which settings module servers use. Dev uses manage.py --settings=bitgigs.settings.local;
# wsgi/asgi default to production if unset.
#DJANGO_SETTINGS_MODULE=bitgigs.settings.production

# Comma-separated hostnames, e.g. bitgigs.example.com,www.bitgigs.example.com
DJANGO_ALLOWED_HOSTS=

# Set to 0 only to exercise the production settings over plain HTTP locally.
#DJANGO_ENABLE_HTTPS=1

# --- Optional SSO via Authentik (or any OpenID Connect provider) ---
# Leave these blank to run BitGigs standalone: native password login, no SSO
# button, no identity provider needed. Set all three to add a "Sign in with
# Authentik" button next to the password form.
#
# SSO can only sign in the *existing* owner account (matched on email) — it never
# creates a user, because BitGigs is single-tenant and a second account would see
# the owner's data. So finish the onboarding wizard first, then link.
#
# In Authentik: create an OAuth2/OpenID provider + application, and register the
# redirect URI  http://localhost:8000/accounts/oidc/authentik/login/callback/
# AUTHENTIK_SERVER_URL is the provider's OpenID configuration issuer, e.g.
#   http://localhost:9000/application/o/bitgigs/
AUTHENTIK_SERVER_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# --- PostgreSQL (production settings only; dev uses SQLite) ---
POSTGRES_DB=bitgigs
POSTGRES_USER=bitgigs
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
