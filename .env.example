# BitGigs configuration — copy to .env and fill in. Gitignored; never commit secrets.
# Read by bitgigs/settings/base.py at startup; real environment variables win over
# this file. Docker Compose reads the same file for the ${…} in compose.yaml.
# Longer explanations live in README.md → Configuration.

# --- Django core ---
# Required in production (it refuses to boot without a real key). Generate one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated, e.g. bitgigs.example.com,www.bitgigs.example.com
DJANGO_ALLOWED_HOSTS=

# wsgi/asgi default to production; dev passes --settings=bitgigs.settings.local.
#DJANGO_SETTINGS_MODULE=bitgigs.settings.production

# Set 0 only to exercise the production settings over plain HTTP locally.
#DJANGO_ENABLE_HTTPS=1

# Only set behind a reverse proxy you control: it makes the rate limiter and the
# sign-in log trust X-Forwarded-For, which is spoofable without one.
#DJANGO_TRUST_PROXY_IP=0

# --- Logging ---
# Console by default — `docker compose logs -f app` and `journalctl -u bitgigs -f`
# already capture it, so there is normally nothing to set here.
#
# Covers BitGigs' own loggers and Django's (request lines, autoreloader). Libraries
# stay at WARNING and per-query SQL stays off, whatever you choose here; a bad value
# falls back to INFO. The level in force is logged at startup, so you can see which
# one took. (DJANGO_LOG_LEVEL is the old name and still works.)
#LOG_LEVEL=INFO
#
# Extra file sink, rotated at 2 MB with five generations kept. Relative paths resolve
# against the repo root; under Docker keep it inside the instance volume so it
# survives replacing the container. (DJANGO_LOG_FILE is the old name.)
#LOG_FILE=instance/bitgigs.log

# --- Optional SSO via any OpenID Connect provider ---
# Leave blank to run standalone: password login, no identity provider needed.
# Set all three to add an SSO button beside the password form.
#
# SSO only signs in the *existing* owner, matched on email — it never creates a
# user (BitGigs is single-tenant), so finish onboarding first, then link.
#
# Register this redirect URI at your provider:
#   http://localhost:8000/accounts/oidc/sso/login/callback/
# OIDC_SERVER_URL is the issuer, e.g. http://localhost:9000/application/o/bitgigs/
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- SSO button appearance (all optional) ---
# Default: "SSO" in the app accent with a shield glyph — right for any provider.
# BRAND is a preset whose icon BitGigs bundles ("authentik" is the only one).
# NAME/COLOR/ICON each override it; ICON is a file you drop in
# assets/static/graphics/ and is used as-is, never recoloured.
#OIDC_PROVIDER_BRAND=authentik
#OIDC_PROVIDER_NAME=Keycloak
#OIDC_PROVIDER_COLOR=#4d4d4d
#OIDC_PROVIDER_ICON=graphics/my_idp.svg

# --- Outgoing mail (optional) ---
# Nothing to set for normal use: SMTP is configured in-app at Settings -> Email,
# which is also where the connection test lives. Set this only to keep the password
# out of the database; it overrides the stored one. (Rotating DJANGO_SECRET_KEY
# makes a *stored* password unreadable — the settings page says so and asks again.)
#EMAIL_HOST_PASSWORD=

# --- PostgreSQL ---
# Used by production, by both compose services, and by dev when DJANGO_DB=postgres.
# POSTGRES_PASSWORD also initializes the compose db container and is required to
# start it.
POSTGRES_DB=bitgigs
POSTGRES_USER=bitgigs
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Dev database switch (local settings only) ---
# Dev defaults to SQLite. Set "postgres" to use the values above, e.g. against
# `docker compose up db`.
#DJANGO_DB=postgres

# --- About page / build metadata (optional) ---
# Surfaced read-only on Settings -> About. Docker sets these itself; a raw checkout
# reads them from git, so you normally don't set them by hand.
#BITGIGS_DEPLOYMENT=docker
#BITGIGS_GIT_COMMIT=
#BITGIGS_BUILD_DATE=
